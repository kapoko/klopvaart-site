{
    "name": "@klopvaart/theme",
    "type": "module",
    "scripts": {
        "build": "wp-scripts build --experimental-modules --blocks-manifest",
        "start": "wp-scripts start --experimental-modules --blocks-manifest",
        "make-pot": "wp i18n make-pot . languages/theme.pot --domain=klopvaart --exclude=node_modules",
        "make-json": "wp i18n make-json languages ../../web/wp-content/languages/themes --no-purge"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^26.6.3",
        "@types/webpack": "^5.28.5",
        "@types/wordpress__block-editor": "^15.0.6",
        "@wordpress/block-editor": "^18.0.0",
        "@wordpress/hooks": "^4.56.0",
        "@wordpress/icons": "^17.0.0",
        "@wordpress/interactivity": "^6.56.0",
        "@wordpress/plugins": "^7.56.0",
        "@wordpress/scripts": "^36.0.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.1"
    },
    "dependencies": {
        "delicious-hamburgers": "^1.2.3"
    },
    "postcss": {
        "plugins": {
            "@tailwindcss/postcss": {}
        }
    }
}
