{
    "name": "@klopvaart/theme",
    "type": "module",
    "scripts": {
        "build": "wp-scripts build --experimental-modules --blocks-manifest",
        "start": "wp-scripts start --experimental-modules --blocks-manifest",
        "make-pot": "wp i18n make-pot . languages/theme.pot --domain=klopvaart --exclude=node_modules",
        "make-json": "wp i18n make-json languages ../../web/wp-content/languages/themes --no-purge"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.2.2",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^25.6.0",
        "@types/webpack": "^5.28.5",
        "@types/wordpress__block-editor": "^15.0.5",
        "@wordpress/block-editor": "^15.16.0",
        "@wordpress/hooks": "^4.43.0",
        "@wordpress/icons": "^12.1.0",
        "@wordpress/interactivity": "^6.43.0",
        "@wordpress/plugins": "^7.43.0",
        "@wordpress/scripts": "^31.8.0",
        "postcss": "^8.5.9",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "vite": "^8.0.8"
    },
    "dependencies": {
        "delicious-hamburgers": "^1.2.3"
    },
    "postcss": {
        "plugins": {
            "@tailwindcss/postcss": {}
        }
    }
}
