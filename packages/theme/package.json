{
    "name": "@klopvaart/theme",
    "type": "module",
    "scripts": {
        "build": "wp-scripts build --experimental-modules --blocks-manifest",
        "start": "wp-scripts start --experimental-modules --blocks-manifest",
        "make-pot": "wp i18n make-pot . languages/theme.pot --domain=klopvaart --exclude=node_modules",
        "make-json": "wp i18n make-json languages ../../web/wp-content/languages/themes --no-purge"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^25.0.6",
        "@types/webpack": "^5.28.5",
        "@types/wordpress__block-editor": "^15.0.0",
        "@wordpress/block-editor": "^15.10.0",
        "@wordpress/hooks": "^4.37.0",
        "@wordpress/icons": "^11.4.0",
        "@wordpress/interactivity": "^6.37.0",
        "@wordpress/plugins": "^7.37.0",
        "@wordpress/scripts": "^31.2.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "dependencies": {
        "delicious-hamburgers": "^1.2.3"
    },
    "postcss": {
        "plugins": {
            "@tailwindcss/postcss": {}
        }
    }
}
