{
    "name": "@klopvaart/theme",
    "type": "module",
    "scripts": {
        "build": "wp-scripts build --experimental-modules --blocks-manifest",
        "start": "wp-scripts start --experimental-modules --blocks-manifest",
        "make-pot": "wp i18n make-pot . languages/theme.pot --domain=klopvaart --exclude=node_modules",
        "make-json": "wp i18n make-json languages ../../web/wp-content/languages/themes --no-purge"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^25.8.0",
        "@types/webpack": "^5.28.5",
        "@types/wordpress__block-editor": "^15.0.6",
        "@wordpress/block-editor": "^15.19.0",
        "@wordpress/hooks": "^4.46.0",
        "@wordpress/icons": "^13.1.0",
        "@wordpress/interactivity": "^6.46.0",
        "@wordpress/plugins": "^7.46.0",
        "@wordpress/scripts": "^32.2.0",
        "postcss": "^8.5.14",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.13"
    },
    "dependencies": {
        "delicious-hamburgers": "^1.2.3"
    },
    "postcss": {
        "plugins": {
            "@tailwindcss/postcss": {}
        }
    }
}
